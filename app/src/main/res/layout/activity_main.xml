<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Local Freehand Circle Selection Overlay -->
    <com.terrasync.app.LassoOverlayView
        android:id="@+id/lassoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top Rail Controls: Single Cloud Sync (left) + Frosted Compass (right) on exact 14dp rails -->
    <LinearLayout
        android:id="@+id/topCluster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/syncStatusContainer"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageButton
                    android:id="@+id/btnSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Sync Status"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cloud_sync" />

                <TextView
                    android:id="@+id/tvSyncPendingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnSentToggle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="188dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All Pins"
                android:textColor="#1C1E1B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnCompass"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:alpha="0"
                android:contentDescription="Reset Compass North"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_compass_dial"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Custom Route-From Indicator Banner -->
        <LinearLayout
            android:id="@+id/routeFromBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRouteFromText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="248dp"
                    android:text="From: Custom Point"
                    android:textColor="#1C1E1B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRouteFromHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Tap a pin or place as destination"
                    android:textColor="#6E716B"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnClearRouteFrom"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear Route From"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active Turn-by-Turn Navigation Banner (Top: Giant Distance + BiDi Street Instruction) -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNavArrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNavStepDist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNavInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#EBF9F0"
                android:textDirection="firstStrong"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls Container (locked to exact 14dp left/right rails) -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Left (Speed HUD + Scale Bar) and Right (Optional Zoom Pill + Quarter-Circle Arc + Oversized Primary FAB) -->
        <LinearLayout
            android:id="@+id/mapControlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- Left Column: Live Driving Speed Indicator + Scale Bar -->
            <LinearLayout
                android:id="@+id/leftBottomColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="start|bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/speedBadge"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#1C1E1B"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpeedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="km/h"
                        android:textColor="#6E716B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scaleBarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="0dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/tvScaleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:paddingStart="2dp"
                        android:shadowColor="#E6F9F9F7"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="4"
                        android:text="5 km"
                        android:textColor="#1C1E1B"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <com.terrasync.app.ScaleBarView
                        android:id="@+id/scaleBarLine"
                        android:layout_width="124dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Chrome Column: Lifted +10dp for clean breathing room above bottom nav tray -->
            <LinearLayout
                android:id="@+id/rightChromeColumn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="end|bottom"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnLasso"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Circle Select Sent Pins"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_lasso"
                    android:visibility="gone" />

                <!-- Option B: Slim Milky-Matte Vertical + / - Pill (Default OFF; toggled via Settings) -->
                <LinearLayout
                    android:id="@+id/zoomPillContainer"
                    android:layout_width="46dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnZoomIn"
                        android:layout_width="46dp"
                        android:layout_height="45dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Zoom In"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_plus" />

                    <View
                        android:id="@+id/zoomPillDivider"
                        android:layout_width="24dp"
                        android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btnZoomOut"
                        android:layout_width="46dp"
                        android:layout_height="45dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="Zoom Out"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_minus" />
                </LinearLayout>

                <!-- Concept Quarter-Circle Arc (52dp Milky-Matte Circles) around Oversized 66dp Dark Primary FAB -->
                <FrameLayout
                    android:id="@+id/rightArcCluster"
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- 1. Directly above FAB: Layers -->
                    <ImageButton
                        android:id="@+id/btnStyleToggle"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginBottom="78dp"
                        android:contentDescription="Map Style &amp; Layers"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_layers" />

                    <!-- 2. Diagonally top-left of FAB: Ruler -->
                    <ImageButton
                        android:id="@+id/btnRuler"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="59dp"
                        android:layout_marginBottom="59dp"
                        android:contentDescription="Measure Distance"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ruler" />

                    <!-- 3. Directly left of FAB: Filter -->
                    <ImageButton
                        android:id="@+id/btnStatusFilter"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="78dp"
                        android:contentDescription="Filter Pins"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_filter" />

                    <!-- Oversized 66dp Deep Espresso-Charcoal Primary Recenter FAB -->
                    <ImageButton
                        android:id="@+id/btnLocate"
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="My Location"
                        android:padding="17dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_my_location" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 5-Second Floating Undo Pill for Accidental Field Status Edits -->
        <LinearLayout
            android:id="@+id/undoBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="10dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvUndoMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnUndoAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="34dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Undo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Ruler Measurement Card (Visible Only in Ruler Mode) -->
        <LinearLayout
            android:id="@+id/rulerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvRulerDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="0 m"
                    android:textColor="#1C1E1B"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRulerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tap map to add measurement points"
                    android:textColor="#6E716B"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnRulerReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Clear"
                android:textColor="#F0651F"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnRulerUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo Point"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo" />

            <ImageButton
                android:id="@+id/btnRulerClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Ruler"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Lasso Circle-Select Card (Visible Only in Circle Select Mode) -->
        <LinearLayout
            android:id="@+id/lassoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLassoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Draw circle around sent pins"
                        android:textColor="#1C1E1B"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLassoSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Local to this phone only"
                        android:textColor="#6E716B"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnLassoModeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Move Map"
                    android:textColor="#18794E"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnLassoClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Circle Select"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLassoMarkSent"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.35"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Mark Sent"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLassoRedraw"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="0.9"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Redraw"
                    android:textColor="#1C1E1B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLassoUndo"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="0.8"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Undo"
                    android:textColor="#1C1E1B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLassoReset"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="0.95"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Reset"
                    android:textColor="#D93025"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Turn-by-Turn Bottom Trip Bar (One-Handed ETA + Voice + Stop) -->
        <LinearLayout
            android:id="@+id/navBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNavEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0 min"
                    android:textColor="#18794E"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNavMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="#6E716B"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnNavVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Toggle Voice"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_volume_on" />

            <ImageButton
                android:id="@+id/btnNavStop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Stop Navigation"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Two-Layer Floating Bottom Navigation Bar: Frosted Outer Tray (62dp, 32dp radius, 6dp padding) + 4 Neutral White Inner Pills -->
        <com.terrasync.app.SwipeDockFrameLayout
            android:id="@+id/bottomNavDock"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/bottomIconRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnTabSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:contentDescription="Search"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search" />

                <ImageButton
                    android:id="@+id/btnTabBookmarks"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:contentDescription="Bookmarks"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bookmarks_list" />

                <ImageButton
                    android:id="@+id/btnTabSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:contentDescription="Settings"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />

                <ImageButton
                    android:id="@+id/btnTabAbout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="About"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info" />
            </LinearLayout>
        </com.terrasync.app.SwipeDockFrameLayout>
    </LinearLayout>

    <!-- Invisible Bottom-Edge Swipe-Up Catcher (Active Only in Full-Screen Clean Map Mode) -->
    <View
        android:id="@+id/fullScreenSwipeUpCatcher"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Calm Solid Alabaster Bottom Sheet (28dp top corners, centered 36x4dp handle, zero inner shadows) -->
    <LinearLayout
        android:id="@+id/inScreenSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="250dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/sheetDragHandle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/sheetStickyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sheetScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/sheetContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Full-Screen Animated Page Host -->
    <FrameLayout
        android:id="@+id/pageOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
