<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Icon-Only Overlay Row -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">

        <ImageButton
            android:id="@+id/btnSyncStatus"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="Sync Status"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cloud_sync" />

        <ImageButton
            android:id="@+id/btnStyleToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="Switch Map Style"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_satellite" />
    </FrameLayout>

    <!-- Active Turn-by-Turn Navigation Card (Only shown while navigating) -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNavArrow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNavInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNavMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNavVoice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Toggle Voice"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_on" />

        <ImageButton
            android:id="@+id/btnNavStop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Stop Navigation"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Bottom Controls: Floating Right Map Action Icons + 4-Icon Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnImport"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Import KML or KMZ"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_import_file" />

            <ImageButton
                android:id="@+id/btnLocate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="My Location"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_my_location" />
        </LinearLayout>

        <!-- 4-Icon Navigation Bar (No Text) -->
        <LinearLayout
            android:id="@+id/bottomIconBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnTabSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Search"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btnTabLayers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Layers"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_layers" />

            <ImageButton
                android:id="@+id/btnTabBookmarks"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Bookmarks"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bookmark" />

            <ImageButton
                android:id="@+id/btnTabSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Settings"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
