<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Left Floating Icon Cluster (Organic Maps Style: Style Toggle + Filter + Sync Dot) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnStyleToggle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Map Style"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_layers" />

        <ImageButton
            android:id="@+id/btnStatusFilter"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Filter Pins"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_filter" />

        <ImageButton
            android:id="@+id/btnSyncStatus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Sync Status"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cloud_sync" />
    </LinearLayout>

    <!-- Active Turn-by-Turn Navigation Banner -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNavArrow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNavInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNavMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNavVoice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Voice"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_on" />

        <ImageButton
            android:id="@+id/btnNavStop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop Navigation"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Bottom Controls: Floating Right Map Buttons (+, -, Import, GPS) + Scale Bar + 4 Floating Bottom Squares -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Dynamic Distance Scale Bar (Bottom-Left) -->
            <LinearLayout
                android:id="@+id/scaleBarContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvScaleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 km"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/scaleBarLine"
                    android:layout_width="80dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="2dp"
                    android:background="#1E293B" />
            </LinearLayout>

            <!-- Right-Edge Floating Controls (+, -, Import, My Location) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Zoom In"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus" />

                <ImageButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginBottom="14dp"
                    android:contentDescription="Zoom Out"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_minus" />

                <ImageButton
                    android:id="@+id/btnImport"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Import KML or KMZ"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_import_file" />

                <ImageButton
                    android:id="@+id/btnLocate"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="My Location"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_my_location" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 4 Separate Floating White Rounded-Square Icons (Organic Maps Style, Zero Text) -->
        <LinearLayout
            android:id="@+id/bottomIconRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabSearch"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:contentDescription="Search"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabBookmarks"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:contentDescription="Bookmarks and Tracks"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bookmarks_list" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabSettings"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:contentDescription="Settings"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabAbout"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:contentDescription="About"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Smooth In-Screen Peek -> Expand Bottom Sheet (Pin Details / Tapped Building / Route Preview) -->
    <LinearLayout
        android:id="@+id/inScreenSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="16dp"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="250dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/sheetDragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/sheetContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="28dp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Full-Screen Animated Page Host (Bookmarks & Tracks, Pin List, Search, Settings, About) -->
    <FrameLayout
        android:id="@+id/pageOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
