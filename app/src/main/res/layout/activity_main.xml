<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Local Freehand Circle Selection Overlay -->
    <com.terrasync.app.LassoOverlayView
        android:id="@+id/lassoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Top Left Controls + Optional Route-From Origin Pill -->
    <LinearLayout
        android:id="@+id/topCluster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/btnStyleToggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="Map Style"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_layers" />

            <ImageButton
                android:id="@+id/btnStatusFilter"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Filter Pins"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_filter" />

            <ImageButton
                android:id="@+id/btnSyncStatus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:contentDescription="Sync Status"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cloud_sync" />

            <TextView
                android:id="@+id/btnSentToggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="All Pins"
                android:textColor="#334155"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Custom Route-From Indicator Banner -->
        <LinearLayout
            android:id="@+id/routeFromBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRouteFromText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="240dp"
                android:text="From: Custom Point"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClearRouteFrom"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear Route From"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active Turn-by-Turn Navigation Banner -->
    <LinearLayout
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNavArrow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="↑"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNavInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNavMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNavVoice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Voice"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_volume_on" />

        <ImageButton
            android:id="@+id/btnNavStop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stop Navigation"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Bottom Controls: Speedometer + Scale Bar left, Ruler/Zoom/Import/GPS right, 4 Tabs or Ruler Card below -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <!-- Left Column: Live Driving Speed Indicator + Scale Bar -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginBottom="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="start|bottom"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/speedBadge"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSpeedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpeedUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="km/h"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scaleBarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvScaleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 km"
                        android:textColor="#1E293B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/scaleBarLine"
                        android:layout_width="80dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="2dp"
                        android:background="#1E293B" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right-Edge Floating Controls (Ruler, +, -, Import, My Location) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnLasso"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Circle Select Sent Pins"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_lasso" />

                <ImageButton
                    android:id="@+id/btnRuler"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Measure Distance"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ruler" />

                <ImageButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Zoom In"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus" />

                <ImageButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Zoom Out"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_minus" />

                <ImageButton
                    android:id="@+id/btnImport"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Import KML or KMZ"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_import_file" />

                <ImageButton
                    android:id="@+id/btnLocate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="My Location"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_my_location" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ruler Measurement Card (Visible Only in Ruler Mode) -->
        <LinearLayout
            android:id="@+id/rulerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnRulerUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo Point"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRulerDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 m"
                    android:textColor="#0F172A"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRulerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap map to add measurement points"
                    android:textColor="#64748B"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/btnRulerReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="Reset all pins"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRulerClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Ruler"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Lasso Circle-Select Card (Visible Only in Circle Select Mode) -->
        <LinearLayout
            android:id="@+id/lassoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLassoTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Draw circle around sent pins"
                        android:textColor="#0F172A"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLassoSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Local to this phone only"
                        android:textColor="#64748B"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnLassoModeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Move Map"
                    android:textColor="#1D4ED8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnLassoClose"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Circle Select"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLassoMarkSent"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.35"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Mark Sent"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLassoRedraw"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.9"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Redraw"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLassoUndo"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.8"
                    android:layout_marginEnd="6dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Undo"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLassoReset"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.95"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Reset"
                    android:textColor="#DC2626"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4 Separate Floating Rounded-Square Icons -->
        <LinearLayout
            android:id="@+id/bottomIconRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabSearch"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="Search"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabBookmarks"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="Bookmarks"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_bookmarks_list" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabSettings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="Settings"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">
                <ImageButton
                    android:id="@+id/btnTabAbout"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="About"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Smooth In-Screen Peek -> Expand Bottom Sheet -->
    <LinearLayout
        android:id="@+id/inScreenSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="16dp"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="250dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/sheetDragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/sheetContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Full-Screen Animated Page Host -->
    <FrameLayout
        android:id="@+id/pageOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
